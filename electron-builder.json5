{
  productName: 'Flare Player',
  appId: 'com.flare.player',
  copyright: 'ⓒ 2021-2025 Jooy2 (jooy2.com)',
  asar: true,
  extends: null,
  compression: 'maximum',
  artifactName: '${productName} ${version}_${arch}.${ext}',
  directories: {
    buildResources: './buildAssets/installer/',
    output: './release/${version}',
  },
  // Source maps are for debugging the bundles, and nothing reads them at run time.
  files: ['dist/**/*', '!**/*.map', '!release/**/*', '!tests/**/*'],
  // Electron ships every Chromium locale. Only the app's own languages are kept,
  // with the regional ones Chromium falls back on for them, each under its
  // Windows and Linux `.pak` name and its macOS `.lproj` name. Any other system
  // language gets Chromium's own strings in English, as the app's text does.
  electronLanguages: [
    'de',
    'en',
    'en-US',
    'en-GB',
    'en_GB',
    'es',
    'es-419',
    'es_419',
    'fr',
    'ja',
    'ko',
    'pt-BR',
    'pt_BR',
    'pt-PT',
    'pt_PT',
  ],
  fileAssociations: [
    {
      ext: 'swf',
      name: 'SWF File',
      role: 'Viewer',
    },
  ],
  win: {
    target: [
      {
        target: 'zip',
        arch: ['x64', 'arm64'],
      },
      {
        target: 'nsis',
        arch: ['x64', 'arm64'],
      },
    ],
    icon: './buildAssets/installer/icon.ico',
  },
  nsis: {
    oneClick: true,
    // One installer for each architecture, rather than one that carries both.
    buildUniversalInstaller: false,
  },
  mac: {
    identity: null,
    hardenedRuntime: true,
    gatekeeperAssess: false,
    icon: 'buildAssets/installer/icon.icns',
    type: 'distribution',
    target: [
      {
        target: 'dmg',
        arch: ['x64', 'arm64'],
      },
    ],
  },
  linux: {
    executableName: 'flare',
    icon: 'buildAssets/installer',
    category: 'Game',
    synopsis: 'SWF Flash Player based on Ruffle',
    // The type shared-mime-info gives `.swf` files, and its older alias, so file
    // managers offer the app for them without the package defining a type of
    // its own.
    mimeTypes: ['application/vnd.adobe.flash.movie', 'application/x-shockwave-flash'],
    target: [
      {
        target: 'deb',
        arch: ['x64', 'arm64'],
      },
      {
        target: 'rpm',
        arch: ['x64', 'arm64'],
      },
      {
        target: 'AppImage',
        arch: ['x64', 'arm64'],
      },
    ],
  },
  // Each Linux package is named the way its own system names packages, with no
  // spaces and with that system's architecture names, such as `amd64` for deb
  // and `x86_64` for rpm.
  deb: {
    artifactName: '${name}_${version}_${arch}.${ext}',
  },
  rpm: {
    artifactName: '${name}-${version}.${arch}.${ext}',
    // Every Electron app ships the same Electron binaries, and their build-id
    // links in `/usr/lib/.build-id` would make two such packages conflict.
    fpm: ['--rpm-rpmbuild-define=_build_id_links none'],
  },
  appImage: {
    artifactName: '${name}-${version}-${arch}.${ext}',
  },
}
